    "strsplit",
    "time",
}

-- core/ gets plain Lua 5.1 only, so a WoW API call there fails the lint.

files["wow/"] = {
    read_globals = wow_read_globals,
    globals = {
        "ForeverGroups",
        "ForeverGroups_OnAddonCompartmentClick",
        "ForeverGroupsCharDB",
        "ForeverGroupsDB",
        "DungeonQueueDB",
        "DungeonQueueCharDB",
        "SLASH_FOREVERGROUPS1",
        "SLASH_FOREVERGROUPS2",
        "SLASH_FOREVERGROUPS3",
        "SlashCmdList",
        "StaticPopupDialogs",
    },
}

files["probe/"] = {
    read_globals = wow_read_globals,
    globals = {
        "ForeverGroupsProbeDB",
        "SLASH_FOREVERGROUPSPROBE1",
        "SLASH_FOREVERGROUPSPROBE2",
        "SlashCmdList",
        "StaticPopupDialogs",
    },
}

files["tests/helpers/wowmock.lua"] = {
    read_globals = { "setfenv", "unpack" },
}
