package-as: ForeverGroups

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - .claude
  - tests
  - scripts
  - tools
  - probe
  - dist
  - .busted
  - .luacheckrc
  - media/logo-1024.png
  - media/logo-400.png
  - media/banner.png
  - media/source
  - docs
  - CHANGELOG.md
  - OVERVIEW.md
  - media/screenshots
